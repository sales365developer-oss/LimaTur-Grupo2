<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#F7F9F8">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="18dp" android:paddingTop="14dp" android:paddingBottom="2dp"
        android:text="LimaTur" android:textColor="#124D49" android:textSize="26sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="18dp" android:paddingBottom="10dp"
        android:text="Descubre los lugares turísticos de Lima" android:textColor="#60716E" android:textSize="14sp"/>
    <EditText android:id="@+id/searchInput" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_marginHorizontal="14dp" android:layout_marginBottom="8dp"
        android:paddingHorizontal="14dp" android:hint="Buscar lugar turístico..."
        android:singleLine="true" android:backgroundTint="#0B6E69" android:inputType="text"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="12dp" android:gravity="center_vertical">
        <Spinner android:id="@+id/typeFilter" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"/>
        <Spinner android:id="@+id/districtFilter" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"/>
        <Switch android:id="@+id/nightSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Noche" android:textSize="12sp" android:paddingStart="4dp"/>
    </LinearLayout>
    <TextView android:id="@+id/resultsCount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="18dp" android:paddingVertical="5dp"
        android:text="50 lugares encontrados" android:textColor="#536561" android:textSize="12sp"/>
    <FrameLayout android:id="@+id/mapContainer" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
